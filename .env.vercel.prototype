# Workflow Agency - Vercel prototype environment template
# Copy these keys into Vercel Project Settings -> Environment Variables.
# Do not commit real secrets. Keep this file as placeholders only.

SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app
TIME_ZONE=Africa/Nairobi

# Prototype database.
# This client-demo path bundles prototype.sqlite3 with users and demo marketplace data.
# Vercel writes a runtime copy to /tmp because serverless project files are read-only.
# Demo edits may reset after cold starts or redeploys. Use Heroku Postgres for production.
VERCEL_BUNDLED_SQLITE=True
VERCEL_SQLITE_SOURCE=prototype.sqlite3
VERCEL_SQLITE_RUNTIME_PATH=/tmp/workflowagency-prototype.sqlite3
VERCEL_SQLITE_RESET_ON_BOOT=False
DATABASE_URL=

# Cloudinary free plan is suitable for prototype uploads.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Security. Keep HTTPS enabled on Vercel.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin

# M-Pesa prototype.
# Use sandbox values for a Vercel client demo unless Safaricom live callbacks have been approved.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=replace-with-sandbox-or-live-key
MPESA_CONSUMER_SECRET=replace-with-sandbox-or-live-secret
MPESA_PASSKEY=replace-with-passkey
MPESA_BUSINESS_SHORT_CODE=replace-with-shortcode
MPESA_CALLBACK_BASE_URL=https://your-vercel-project.vercel.app
MPESA_STK_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_OAUTH_PATH=/oauth/v1/generate?grant_type=client_credentials
MPESA_STK_PUSH_PATH=/mpesa/stkpush/v1/processrequest
MPESA_C2B_REGISTER_URL_PATH=/mpesa/c2b/v1/registerurl
